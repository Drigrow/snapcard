[Unit]
Description=SnapCard Knowledge Card Web App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/snapcard
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=snapcard
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
