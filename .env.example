# SnapCard Environment Configuration

# Server Port & Host
PORT=3001
HOST=0.0.0.0

# OpenRouter API Key (Supports Gemini 3.7 Flash, Gemini 3.1 Flash Lite Image, etc.)
OPENROUTER_API_KEY=

# OpenRouter Default Models
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# Tavily Search API Key (for real-time web search and images)
TAVILY_API_KEY=

# Storage Directory for SQLite & Generated WebP Images
DATA_DIR=./data
UPLOAD_DIR=./uploads
