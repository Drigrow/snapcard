    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "prod": "NODE_ENV=production tsx server/index.ts"
  },
  "keywords": [
    "snapcard",
    "knowledge-card",
    "gemini-3.7-flash",
    "tavily",
    "mermaid"
  ],
